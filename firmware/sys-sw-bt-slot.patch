@@ -317,6 +333,9 @@ void dial_sw_scan(void)
             dev_info.sys_sw_state = SYS_SW_WIN;
             keymap_config.nkro    = 1;
             m_break_all_key();
+#ifdef SYS_SW_SELECTS_BT_SLOT
+            sys_sw_select_bt_slot(LINK_BT_2);
+#endif
         }
     } else {
         if (dev_info.sys_sw_state != SYS_SW_MAC) {
@@ -325,6 +344,9 @@ void dial_sw_scan(void)
             dev_info.sys_sw_state = SYS_SW_MAC;
             keymap_config.nkro    = 0;
             m_break_all_key();
