+#ifdef SYS_SW_SELECTS_BT_SLOT
+/**
+ * @brief  Bind the Mac/Win switch to a Bluetooth slot: Mac -> BT1, Win -> BT2.
+ */
+static void sys_sw_select_bt_slot(uint8_t slot)
+{
+    if (dev_info.rf_channel == slot && dev_info.ble_channel == slot) return;
+    dev_info.rf_channel  = slot;
+    dev_info.ble_channel = slot;
+    if (dev_info.link_mode != LINK_USB) {
+        dev_info.link_mode = slot;
+        uart_send_cmd(CMD_SET_LINK, 10, 20);
+    }
+}
+#endif
+
 /**
  * @brief  scan dial switch.
