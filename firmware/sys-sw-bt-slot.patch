     Sleep_Handle();
 }
+
+#ifdef SYS_SW_SELECTS_BT_SLOT
+#include "via.h"
+/**
+ * @brief  VIA custom value: channel 0 (id_custom_channel), value 0x01 returns
+ *         [link_mode, ble_channel, sys_sw_state] so the host can tell wired from
+ *         Bluetooth while a charging cable is attached.
+ */
+void via_custom_value_command_kb(uint8_t *data, uint8_t length)
+{
+    if (data[0] == id_custom_get_value && data[1] == id_custom_channel && data[2] == 0x01) {
+        data[3] = dev_info.link_mode;
+        data[4] = dev_info.ble_channel;
+        data[5] = dev_info.sys_sw_state;
+        return;
+    }
+    data[0] = id_unhandled;
+}
+#endif
